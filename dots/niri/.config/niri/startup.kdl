environment {
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  GDK_BACKEND "wayland"
  MOZ_ENABLE_WAYLAND "1"
  FILE_PICKER "yazi-picker"
  // PATH (~/.local/bin, ~/.nix-profile/bin) lives in ~/.config/environment.d/99-nix-path.conf,
  // since niri doesn't expand $PATH or ~ here
}

//spawn-at-startup "swaybg" "-i" "/home/meta/Pictures/walls/bg.png"
//spawn-at-startup "awww-daemon"
spawn-at-startup "hyprlock"
spawn-at-startup "cliphist" "wipe"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
//spawn-at-startup "swaync"
//spawn-at-startup "hypridle"
//spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "noctalia"
spawn-sh-at-startup "~/.config/niri/float-ext.sh"
