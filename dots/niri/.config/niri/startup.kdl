environment {
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  GDK_BACKEND "wayland"
  MOZ_ENABLE_WAYLAND "1"
  NOCTALIA_PAM_SERVICE "noctalia"
  // niri doesn't expand $PATH or ~ here, so this is the full PATH with ~/.local/bin added
  PATH "/home/thomal/.local/bin:/home/thomal/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
}

//spawn-at-startup "swaybg" "-i" "/home/thomal/Pictures/bg.png"
//spawn-at-startup "awww-daemon"
spawn-at-startup "cliphist" "wipe"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
//spawn-at-startup "swaync"
//spawn-at-startup "hypridle"
//spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "noctalia"
spawn-at-startup "/home/thomal/.config/niri/float-ext.sh"
