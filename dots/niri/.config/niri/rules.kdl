layer-rule {
  match namespace="^rofi$"

  shadow {
    on
  }
}

layer-rule {
  match namespace="awww-daemon"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-overview"
  place-within-backdrop true
}

window-rule {
  match app-id="teams-for-linux"
  open-on-output "eDP-1"
  open-fullscreen false
}

window-rule {
  match app-id=r#"zen$"# title="^Picture-in-Picture$"
  open-floating true
}
window-rule {
  match app-id=r#"zen$"# title="Sign in to your account — Zen Browser"
  open-floating true
}

window-rule {
  match app-id="blueberry.py"
  open-floating true
}

// psm's nested weston: maximize instead of fullscreen so floating windows stay on top
window-rule {
  match title="^Weston Compositor"
  open-fullscreen false
  open-maximized-to-edges true
}

window-rule {
  match app-id="nm-connection-editor"
  open-floating true
}

window-rule {
  match app-id="org.keepassxc.KeePassXC"
  open-floating true
}

window-rule {
  match app-id="java" title="Dbeaver"
  open-floating true
}

window-rule {
  match app-id="pavucontrol"
  open-floating true
}

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  draw-border-with-background false
}

window-rule {
  match app-id="kitty"
  default-column-width { proportion 0.5; }
}
window-rule {
  match app-id="org.pwmt.zathura"
  default-column-width { proportion 0.5; }
}
// PCSX2 reference runs (ps2-recomp-test/sly3/tools/run-pcsx2.sh), on the second monitor
window-rule {
  match app-id=r#"(?i)pcsx2"#
  open-on-output "DP-2"
  open-focused false
}
// Sly 3 recompiled runner (ps2-recomp-test/sly3)
window-rule {
  match title=r#"\(recompiled\)$"#
  open-on-output "DP-2"
  open-focused false
  default-column-width { proportion 0.5; }
}
window-rule {
  match app-id="vimfox"
  open-on-output "eDP-1"
  open-focused false
  default-column-width { proportion 0.5; }
}

window-rule {
  match is-window-cast-target=true

  focus-ring {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }

  border {
    inactive-color "#7d0d2d"
  }

  shadow {
    color "#7d0d2d70"
  }

  tab-indicator {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }
}

window-rule {
  match app-id="steam_app_*"
  open-fullscreen true
  open-focused true
}

// Steam friends list as a small popup instead of a tiled column
window-rule {
  match app-id=r#"^steam$"# title="^Friends List$"
  open-floating true
}
